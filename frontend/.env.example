# Copy to .env.local for local work. Staging and production values live in the
# host dashboard — see docs/environments.md. NEXT_PUBLIC_* are inlined at build
# and are public. Do not put JWT, SMTP, webhook, or provider keys here.

# Canonical origin (no trailing slash). Use localhost locally so SEO tags
# do not claim the production domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Express backend origin (no /api suffix).
# next.config.ts remotePatterns allow CMS images from this origin under /assets/**
# when STORAGE_DRIVER=local serves uploads there (Cloudinary driver reserved).
NEXT_PUBLIC_API_URL=http://localhost:5000

# Optional. Server-only SSR override if the Next server should reach the API
# on an internal URL. Unset = use NEXT_PUBLIC_API_URL.
# API_URL=

# Optional. Server-only. Inquiry JSON webhook if POST /api/v1/contacts fails.
# CONTACT_WEBHOOK_URL=

# Optional. Server-only. Receives structured error JSON from lib/log.ts.
# ERROR_WEBHOOK_URL=

# Match the backend server-only value; never NEXT_PUBLIC_
CATALOGUE_REVALIDATE_SECRET=
