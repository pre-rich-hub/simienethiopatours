generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// AUTH
// ---------------------------------------------------------------------------

model Admin {
  id            Int     @id @default(autoincrement())
  name          String?
  email         String? @unique
  passwordHash  String? @map("password_hash")
  profilePicUrl String? @map("profile_pic_url")
  tokenVersion  Int     @default(0) @map("token_version")

  @@map("admin_table")
}

// ---------------------------------------------------------------------------
// CATALOG — Customize these models per client (tours, products, services, etc.)
// ---------------------------------------------------------------------------

model Tour {
  id            Int      @id @default(autoincrement())
  destinationId Int?     @map("destination_id")
  slug          String   @unique @db.VarChar(255)
  tourName      String   @map("tour_name")
  adultPrice    Decimal? @map("adult_price") @db.Decimal(10, 2)
  childPrice    Decimal? @map("child_price") @db.Decimal(10, 2)
  discount      String?
  rating        Decimal? @db.Decimal(3, 1)
  noOfRates     Int?     @map("no_of_rates")
  isFeatured    Boolean? @default(false) @map("is_featured")
  overview      String?  @db.Text
  summary       String?  @db.Text
  itineraryIntro String? @map("itinerary_intro") @db.Text
  itineraryNotes String? @map("itinerary_notes") @db.Text // JSON string[]
  included      String?  @db.Text
  excluded      String?  @db.Text
  itinerary     String?  @db.Text
  journeyMap    String?  @map("journey_map") @db.Text

  // Editorial fields (P1 content pipeline) — mirrors frontend JourneyDetail
  heroTitle   String?  @map("hero_title") @db.VarChar(500)
  heroAccent  String?  @map("hero_accent") @db.VarChar(500)
  image       String?  @db.VarChar(500)
  imageAlt    String?  @map("image_alt") @db.VarChar(500)
  duration    String?  @db.VarChar(255)
  style       String?  @db.VarChar(255)
  difficulty  String?  @db.VarChar(255)
  fit         String?  @db.VarChar(500)
  journeyType String   @default("core-trek") @map("journey_type") @db.VarChar(50)
  editorialStatus String @default("published") @map("editorial_status") @db.VarChar(20)
  editorialSourceNotes String? @map("editorial_source_notes") @db.Text
  inquiry     String?  @db.VarChar(255)
  notice      String?  @db.Text
  route       String?  @db.Text // JSON string[]
  facts       String?  @db.Text // JSON {label,value}[]
  introduction String? @db.Text // JSON string[]
  highlights  String?  @db.Text // JSON Feature[]
  preparation String?  @db.Text // JSON string[]
  related     String?  @db.Text // JSON Feature[]
  isPublished Boolean  @default(false) @map("is_published")
  sortOrder   Int      @default(0) @map("sort_order")

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  destination  Destination?         @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  gallery      Gallery[]
  media        TourMedia[]
  bookings     Booking[]
  categories   TourCategoryJunction[]
  destinations TourDestinationJunction[]
  blockedDates TourBlockedDate[]

  @@map("tours")
}

model Destination {
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  id               Int      @id @default(autoincrement())
  slug             String   @unique @db.VarChar(255)
  destinationName  String   @map("destination_name")
  description      String?  @db.Text
  area             String   @default("gondar") @db.VarChar(40)
  type             String   @default("other") @db.VarChar(40)
  location         String?  @db.Text
  alsoKnownAs      String?  @map("also_known_as") @db.Text
  heroTitle        String?  @map("hero_title") @db.VarChar(500)
  heroAccent       String?  @map("hero_accent") @db.VarChar(500)
  overview         String?  @db.Text
  highlights       String?  @db.Text
  thingsToDo       String?  @map("things_to_do") @db.Text
  imageUrl         String?  @map("image_url")
  imageAlt         String?  @map("image_alt") @db.VarChar(500)
  sourceReferences String?  @map("source_references") @db.Text
  editorialStatus String @default("published") @map("editorial_status") @db.VarChar(20)
  editorialSourceNotes String? @map("editorial_source_notes") @db.Text
  isPublished      Boolean  @default(true) @map("is_published")
  sortOrder        Int      @default(0) @map("sort_order")
  tours           Tour[]
  tourLinks       TourDestinationJunction[]
  media           DestinationMedia[]

  @@map("destinations")
}

model TourDestinationJunction {
  tourId        Int         @map("tour_id")
  destinationId Int         @map("destination_id")
  tour          Tour        @relation(fields: [tourId], references: [id], onDelete: Cascade)
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@id([tourId, destinationId])
  @@index([destinationId])
  @@map("tour_destination_junction")
}

model TourCategory {
  id           Int                    @id @default(autoincrement())
  categoryName String                 @map("category_name")
  slug         String?                @unique @db.VarChar(255)
  createdAt    DateTime?              @map("created_at")
  tours        TourCategoryJunction[]

  @@map("tour_category")
}

model TourCategoryJunction {
  tourId     Int          @map("tour_id")
  categoryId Int          @map("category_id")
  tour       Tour         @relation(fields: [tourId], references: [id], onDelete: Cascade)
  category   TourCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([tourId, categoryId])
  @@map("tour_category_junction")
}

model Gallery {
  id       Int     @id @default(autoincrement())
  imageUrl String  @map("image_url")
  title    String? @db.VarChar(255)
  location String? @db.VarChar(255)
  category String? @db.VarChar(255)
  alt      String? @db.VarChar(500)
  story    String? @db.Text
  href     String? @db.VarChar(500)
  link     String? @db.VarChar(255)
  tourId   Int?    @map("tour_id")
  tour     Tour?   @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@unique([imageUrl])
  @@map("gallery")
}

model TourBlockedDate {
  id     Int      @id @default(autoincrement())
  tourId Int      @map("tour_id")
  tour   Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)
  date   DateTime @db.Date
  reason String?

  @@unique([tourId, date])
  @@index([tourId, date])
  @@map("tour_blocked_dates")
}

// ---------------------------------------------------------------------------
// BUSINESS
// ---------------------------------------------------------------------------

model Booking {
  id         Int       @id @default(autoincrement())
  tourId     Int?      @map("tour_id")
  fullName   String    @map("full_name")
  email      String
  phone      String
  country    String
  chosenDate DateTime  @map("chosen_date") @db.Date
  adults     Int       @map("no_of_adults")
  children   Int       @map("no_of_children")
  status     String?   @default("Pending")
  createdAt  DateTime  @default(now()) @map("created_at")
  tour       Tour?     @relation(fields: [tourId], references: [id], onDelete: SetNull)

  @@map("bookings")
}

model Contact {
  id        Int       @id @default(autoincrement())
  name      String
  email     String
  message   String    @db.Text
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("contacts")
}

// ---------------------------------------------------------------------------
// CONTENT
// ---------------------------------------------------------------------------

model Blog {
  isPublished Boolean @default(false) @map("is_published")
  author String? @db.VarChar(255)
  imageAlt String? @map("image_alt") @db.VarChar(500)
  publishedAt DateTime? @map("published_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  id          Int           @id @default(autoincrement())
  slug        String        @unique @db.VarChar(255)
  blogTitle   String        @map("blog_title")
  description String?       @db.Text
  content     String?       @db.Text
  imageUrl    String?       @map("image_url")
  href        String?       @db.VarChar(500)
  categoryId  Int?
  category    BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now()) @map("created_at")

  @@map("blog")
}

model BlogCategory {
  id    Int    @id @default(autoincrement())
  name  String @unique
  slug  String @unique @db.VarChar(255)
  posts Blog[]

  @@map("blog_category")
}

model Subscriber {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  @@map("subscribers")
}

model Testimonial {
  id             Int     @id @default(autoincrement())
  message        String  @db.Text
  reviewerName   String  @map("reviewer_name")
  profession     String?
  source         String?
  title          String?
  date           String?
  avatarTone     String? @map("avatar_tone")
  translatedFrom String? @map("translated_from") @db.VarChar(100)

  @@unique([reviewerName, message])
  @@map("testimonials")
}

// ---------------------------------------------------------------------------
// STORAGE
// ---------------------------------------------------------------------------

model MediaAsset {
  id           String   @id @default(uuid()) @db.Uuid
  content      Bytes?
  mimeType     String   @map("mime_type")
  originalName String?  @map("original_name")
  size         Int
  altText      String?  @map("alt_text") @db.VarChar(500)
  attribution  String?  @db.Text
  license      String?  @db.VarChar(255)
  sourceUrl    String?  @unique @map("source_url") @db.Text
  width        Int?
  height       Int?
  focalPoint   String?  @map("focal_point") @db.VarChar(100)
  tourMedia    TourMedia[]
  destinationMedia DestinationMedia[]
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("media_assets")
}

model TourMedia {
  tourId       Int    @map("tour_id")
  mediaAssetId String @map("media_asset_id") @db.Uuid
  role         String @default("hero") @db.VarChar(40)
  sortOrder    Int    @default(0) @map("sort_order")
  tour         Tour @relation(fields: [tourId], references: [id], onDelete: Cascade)
  mediaAsset   MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)
  @@id([tourId, mediaAssetId, role])
  @@map("tour_media")
}

model DestinationMedia {
  destinationId Int @map("destination_id")
  mediaAssetId  String @map("media_asset_id") @db.Uuid
  role          String @default("hero") @db.VarChar(40)
  sortOrder     Int    @default(0) @map("sort_order")
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  mediaAsset    MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)
  @@id([destinationId, mediaAssetId, role])
  @@map("destination_media")
}

model ContentTranslation {
  id          Int       @id @default(autoincrement())
  entityType  String    @map("entity_type") @db.VarChar(40)
  entitySlug  String    @map("entity_slug") @db.VarChar(255)
  locale      String    @db.VarChar(10)
  status      String    @default("missing") @db.VarChar(20)
  content     String    @db.Text
  sourceHash  String?   @map("source_hash") @db.VarChar(128)
  reviewedAt  DateTime? @map("reviewed_at")
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  @@unique([entityType, entitySlug, locale])
  @@index([locale, status])
  @@map("content_translations")
}

model EditorialReview {
  id                   Int       @id @default(autoincrement())
  entityType           String    @map("entity_type") @db.VarChar(40)
  entitySlug           String    @map("entity_slug") @db.VarChar(255)
  status               String    @default("draft") @db.VarChar(20)
  sourceNotes          String?   @map("source_notes") @db.Text
  reviewerId           Int?      @map("reviewer_id")
  routeApproved        Boolean   @default(false) @map("route_approved")
  commercialApproved   Boolean   @default(false) @map("commercial_approved")
  safetyApproved       Boolean   @default(false) @map("safety_approved")
  translationApproved  Boolean   @default(false) @map("translation_approved")
  reviewedAt           DateTime? @map("reviewed_at")
  publishedAt          DateTime? @map("published_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  @@unique([entityType, entitySlug])
  @@index([status])
  @@map("editorial_reviews")
}

// ---------------------------------------------------------------------------
// AI ASSISTANT — session + usage tracking
// ---------------------------------------------------------------------------

model ChatSession {
  id           String        @id @default(uuid()) @db.Uuid
  ipHash       String?       @map("ip_hash")
  messageCount Int           @default(0) @map("message_count")
  tokenCount   Int           @default(0) @map("token_count")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  messages     ChatMessage[]

  @@map("chat_sessions")
}

model ChatMessage {
  id         Int         @id @default(autoincrement())
  sessionId  String      @map("session_id") @db.Uuid
  session    ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role       String
  content    String      @db.Text
  tokenCount Int         @default(0) @map("token_count")
  createdAt  DateTime    @default(now()) @map("created_at")

  @@index([sessionId, id])
  @@map("chat_messages")
}

model ChatDailyUsage {
  id         Int      @id @default(autoincrement())
  date       DateTime @unique @db.Date
  tokenCount Int      @default(0) @map("token_count")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("chat_daily_usage")
}
