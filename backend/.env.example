NODE_ENV=development
PORT=5000

# Neon PostgreSQL (or any Postgres). Use the -pooler endpoint for runtime,
# direct endpoint for migrations.
DATABASE_URL="postgresql://user:password@host-pooler.example.com/db?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:password@host.example.com/db?sslmode=require"

# Frontend origin for CORS
FRONTEND_ORIGIN=http://localhost:3000

# Auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
AUTH_COOKIE_NAME=admin_session
COOKIE_SECURE=false

# Email (smtp or resend)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Your Brand <info@example.com>"
EMAIL_PROVIDER=smtp
RESEND_API_KEY=
ADMIN_EMAIL=info@example.com
EMAIL_ENABLED=false

# File uploads
UPLOAD_ROOT=.
PUBLIC_FILE_BASE_URL=
MAX_UPLOAD_MB=4

# AI assistant
ASSISTANT_ENABLED=false
# Provider: openai | gemini
ASSISTANT_PROVIDER=gemini
OPENAI_API_KEY=
GEMINI_API_KEY=
ASSISTANT_MODEL=gemini-3.6-flash
# Conversation caps
ASSISTANT_MAX_MESSAGES=30
ASSISTANT_MAX_OUTPUT_TOKENS=1000
ASSISTANT_MAX_HISTORY_MESSAGES=10
ASSISTANT_MAX_CONTEXT_CHARS=40000
ASSISTANT_MAX_DAILY_TOKENS=200000
ASSISTANT_MAX_SESSION_TOKENS=20000
# Streaming
ASSISTANT_STREAM=true
ASSISTANT_STREAM_TIMEOUT_MS=45000
# Context cache TTL (ms)
ASSISTANT_CONTEXT_TTL_MS=300000
# IP hashing salt for usage tracking (falls back to JWT_SECRET)
ASSISTANT_IP_HASH_SALT=
