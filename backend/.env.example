NODE_ENV=development
PORT=5000

# Neon PostgreSQL (or any Postgres). Use the -pooler endpoint for runtime,
# direct endpoint for migrations.
DATABASE_URL="postgresql://user:password@host-pooler.example.com/db?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:password@host.example.com/db?sslmode=require"

# Frontend origin for CORS
FRONTEND_ORIGIN=http://localhost:3000

# Auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
AUTH_COOKIE_NAME=admin_session
COOKIE_SECURE=false

# Email (smtp or resend)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Your Brand <info@example.com>"
EMAIL_PROVIDER=smtp
RESEND_API_KEY=
ADMIN_EMAIL=info@example.com
# Used by `pnpm db:admin` to bootstrap the admin account. Leave empty to use
# the script's local-only fallback. Never commit a real password here.
ADMIN_PASSWORD=
EMAIL_ENABLED=false

# Privacy retention (days)
CONTACT_RETENTION_DAYS=730
ASSISTANT_RETENTION_DAYS=30

# File uploads
# local   -> files on disk under UPLOAD_ROOT, served from /assets/**
# database-> bytes in the Postgres media_assets table, served from /api/v1/media/:id
# On Vercel the serverless disk is ephemeral, so "database" is selected
# automatically unless STORAGE_DRIVER is set explicitly.
# Cloudinary is reserved as a future driver (not implemented yet).
UPLOAD_ROOT=uploads
PUBLIC_FILE_BASE_URL=
MAX_UPLOAD_MB=4
# Storage driver for uploaded images: local | database | cloudinary
STORAGE_DRIVER=local
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=gondar-simien-tours

# AI assistant
ASSISTANT_ENABLED=false
# Provider: openai | gemini | groq
ASSISTANT_PROVIDER=gemini
OPENAI_API_KEY=
# Leave empty for OpenAI's default; set to https://api.groq.com/openai/v1 or
# another OpenAI-compatible endpoint when using a custom base URL.
OPENAI_BASE_URL=
GEMINI_API_KEY=
GROQ_API_KEY=
ASSISTANT_MODEL=gemini-3.6-flash
# Conversation caps
ASSISTANT_MAX_MESSAGES=30
ASSISTANT_MAX_OUTPUT_TOKENS=1000
ASSISTANT_MAX_HISTORY_MESSAGES=10
# Groq free tier needs a smaller budget (e.g. 20000) to stay under per-minute
# token limits.
ASSISTANT_MAX_CONTEXT_CHARS=40000
ASSISTANT_MAX_DAILY_TOKENS=200000
ASSISTANT_MAX_SESSION_TOKENS=20000
# Streaming
ASSISTANT_STREAM=true
ASSISTANT_STREAM_TIMEOUT_MS=45000
# Context cache TTL (ms)
ASSISTANT_CONTEXT_TTL_MS=300000
# IP hashing salt for usage tracking (falls back to JWT_SECRET)
ASSISTANT_IP_HASH_SALT=

# Post-commit public catalogue cache invalidation
CATALOGUE_REVALIDATE_URL=http://localhost:3000/api/revalidate
CATALOGUE_REVALIDATE_SECRET=
