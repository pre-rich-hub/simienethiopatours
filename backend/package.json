{
  "name": "gondar-simien-tours-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.seed.json",
    "prisma:generate": "prisma generate",
    "prisma:pull": "prisma db pull",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:seed": "tsx scripts/seed.ts",
    "db:admin": "tsx scripts/seed-admin.ts",
    "data:purge": "tsx scripts/purge-retention.ts",
    "content:audit": "node --import tsx scripts/audit-public-editorial.ts",
    "content:drift": "node --import tsx scripts/audit-catalogue-drift.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "content:export": "tsx scripts/export-public-catalogue.ts",
    "content:bootstrap": "tsx scripts/bootstrap-public-catalogue.ts",
    "content:translations": "tsx scripts/seed-catalogue-translations.ts",
    "content:localization": "tsx scripts/audit-localization.ts",
    "smoke:admin-publish": "tsx scripts/smoke-admin-publish.ts"
  },
  "dependencies": {
    "@google/genai": "^2.16.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.1",
    "nodemailer": "^9.0.1",
    "openai": "^7.4.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^6.4.17",
    "prisma": "^6.19.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@google/genai",
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "protobufjs"
    ]
  }
}
